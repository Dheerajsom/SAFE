# Bulk InfluxDB downloads (can be many GB at 1 s resolution)
mintsXU4/data/valo_node_01_1s/
mintsXU4/data/valo_node_01_wimda_1s/
*.gz
# ...except the small seeded synthetic PM dataset used for testing
!mintsXU4/data/synthetic_pm/*.csv.gz
*.csv.part

# Rendered media outputs
*.mp4

# Jet-colormap PM animations: rendered as GIFs (~600 MB each) then re-encoded
# to MP4 (~12 MB). Keep the GIFs on disk but track only the MP4s.
mintsXU4/output/animations/*.gif

# Local noise
__pycache__/
*.pyc
.DS_Store

# Packaging / test caches
*.egg-info/
.pytest_cache/
build/
dist/

# Local environments and credentials
.venv/
evaluation_output/
mintsXU4/credentials/
mintsXU4/credentials.yml
